# Copy to .env.local and fill in to enable the live activity feed.
# Leave both UPSTASH_* unset for a fully static build: the site then ships
# sample data in dev and an honest empty feed on Vercel, and the visit beacon
# no-ops.

# Upstash Redis (REST) — the live visit store, and the private /ama ask inbox.
# Both are required together. Unset, the ask box tells visitors it is
# unreachable and points them at email rather than pretending to send.
# Setting exactly ONE of these is a hard configuration error (the app throws at
# the first store call), not a silent fallback to static mode.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Namespace prepended to every key this app writes (activity stream,
# counter, rate-limit buckets). Unset (empty) keeps keys byte-identical to an
# un-prefixed deployment. Set it to isolate a live-store CI run or a parallel
# Conductor workspace, e.g. UPSTASH_KEY_PREFIX=ci-42.
UPSTASH_KEY_PREFIX=

# Salt for the rate-limiter's IP key (a salted SHA-256 is stored, never the raw
# IP). Shared by the visit beacon and the /ama ask box. REQUIRED whenever Redis
# is configured, and must carry at least 32 characters of entropy — there is no
# default, because a predictable salt lets an attacker precompute a visitor's
# bucket. Generate one with:
#
#   openssl rand -base64 32
#
# Rotating it invalidates in-flight rate-limit buckets only; stored activity and
# AMA records are unaffected.
VISIT_IP_SALT=

# Optional. Where a new /ama question is announced, as a JSON POST. Unset means
# no notification: questions still land in the inbox, you just have to go and
# look (`bun run ama:inbox`).
#
# The body carries `text` and `content` with the same summary, so a Slack
# incoming-webhook URL or a Discord webhook URL both work as-is; anything else
# gets `question`, `contact`, `id` and `ts` as structured fields.
#
# Note what this sends: the question text and whatever contact the asker typed
# leave for that endpoint. Point it somewhere only you read.
#
# MUST NOT be renamed to NEXT_PUBLIC_AMA_NOTIFY_URL. A public webhook URL is a
# spam endpoint for anyone who opens the browser bundle.
AMA_NOTIFY_URL=

# Optional. Post new /ama questions as a Discord bot, instead of (or as well
# as) the generic webhook above. What this buys over a Discord webhook URL: a
# real bot identity, any channel the bot is invited to, and DMs — which is the
# useful one, since a DM reaches your phone without a channel to watch.
#
# There is no gateway connection and no slash commands: those need a process
# that stays connected, and this is a serverless deploy. The bot posts, it does
# not listen.
#
# Create an application at https://discord.com/developers/applications, add a
# bot, copy its token here, then set EITHER a channel id OR a user id to DM.
# Channel wins if both are set. Bots may only DM someone they share a server
# with, so invite your bot to any server you are also in.
#
# `bun run discord:setup` checks all of this for you once the token is set.
#
# MUST NOT be renamed to NEXT_PUBLIC_*. A bot token in the browser bundle is
# full control of the bot for anyone who reads it.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_DM_USER_ID=

# These same Discord settings also deliver server-side ERROR ALERTS. Once the bot
# is configured above, `captureError` (via the sink wired in src/instrumentation.ts)
# posts an embed to the same channel/DM — so a broken live store or a throwing route
# reaches your phone with no extra account. Each distinct failure is sent once per
# process (de-duped); the transport's own failures are never reported back to itself.
# Set `ERROR_REPORT_URL` too if you also want a separate webhook/APM sink; they are
# independent.

# Optional. Where server-side errors (route handlers + error boundaries) are
# POSTed as JSON, in addition to the server log. Point at Sentry, Better Stack,
# a Slack workflow, etc. Unset means log-only.
#
# MUST NOT be renamed to NEXT_PUBLIC_ERROR_REPORT_URL: this module is imported by
# client error boundaries, and only the non-public prefix keeps the URL out of
# the browser bundle.
ERROR_REPORT_URL=

# Required only for the scheduled daily activity report (`vercel.json` `crons`
# -> `GET /api/cron/daily-report`, which posts to the Discord bot above).
# Vercel sends `Authorization: Bearer $CRON_SECRET` with every cron request and
# the route accepts nothing else; UNSET, the endpoint is closed rather than
# open — the daily report simply does not fire (and `next` returns 503 to the
# cron, so the failure is visible in the Vercel cron log). Generate one:
#
#   openssl rand -base64 32
#
# `bun run activity:report` posts the same report from the terminal without
# needing this variable (it calls the library directly, not the route).
#
# MUST NOT be renamed to NEXT_PUBLIC_CRON_SECRET: a readable cron secret lets
# anyone trigger the bot on demand.
CRON_SECRET=