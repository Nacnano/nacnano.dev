{
  "name": "nacnano-blog-client",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "next start",
    "serve": "next start",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "bun run build:next && bun run build:csp-hashes && bun run build:next && bun run build:csp-hashes -- --check && bun ./src/scripts/postbuild.ts",
    "build:next": "cross-env INIT_CWD=$PWD next build",
    "build:csp-hashes": "bun ./src/scripts/cspScriptHashes.ts",
    "lint": "oxlint --deny-warnings . && biome lint --error-on-warnings . && bun ./src/scripts/checkEnvVars.ts",
    "lint:fix": "oxlint --fix . && biome lint --write . && bun ./src/scripts/checkEnvVars.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "ama:inbox": "bun ./src/scripts/amaInbox.ts",
    "verify:csp": "bun ./src/scripts/verifyCsp.ts",
    "discord:setup": "bun ./src/scripts/discordSetup.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/typography": "^0.5.9",
    "@upstash/ratelimit": "^2",
    "@upstash/redis": "^1",
    "autoprefixer": "^10.4.13",
    "cobe": "^2",
    "gray-matter": "^4.0.2",
    "next": "^16",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4",
    "postcss": "^8.4.24",
    "react": "^19",
    "react-dom": "^19",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7",
    "rehype-prism-plus": "^2",
    "rehype-slug": "^6",
    "remark-gfm": "^4",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/mdx": "^2.0.5",
    "@types/node": "^20.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "oxlint": "1.82.0",
    "prettier": "^3.0.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.1.3"
  }
}
