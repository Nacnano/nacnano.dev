{
  "name": "nacnano-blog-client",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build && bun ./src/scripts/postbuild.ts",
    "serve": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/typography": "^0.5.9",
    "@upstash/ratelimit": "^1",
    "@upstash/redis": "^1",
    "autoprefixer": "^10.4.13",
    "cobe": "^2",
    "gray-matter": "^4.0.2",
    "next": "^16",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4",
    "postcss": "^8.4.24",
    "react": "^19",
    "react-dom": "^19",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7",
    "rehype-prism-plus": "^2",
    "rehype-slug": "^6",
    "remark-gfm": "^4",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/mdx": "^2.0.5",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-custom": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.0.0",
    "tsconfig": "workspace:*",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
