{
  "name": "nacnano-blog-client",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build && bun ./src/scripts/postbuild.ts",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --dir src/app --dir src/components --dir src/layouts --dir src/lib --dir src/scripts",
    "lint:fix": "bun run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.13",
    "gray-matter": "^4.0.2",
    "next": "^14.2.35",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.2.1",
    "postcss": "^8.4.24",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7",
    "rehype-prism-plus": "^2",
    "rehype-slug": "^6",
    "remark-gfm": "^4",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.0.1",
    "@types/bun": "^1.4.2",
    "@types/mdx": "^2.0.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "tsconfig": "workspace:*",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
