{
  "name": "nacnano.dev",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,jsonc,md,mdx,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,jsonc,md,mdx,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@turbo/gen": "^2.11.7",
    "oxlint": "1.87.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7"
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "core-js-pure"
  ],
  "overrides": {
    "source-map-js": "1.2.2",
    "sharp": "0.35.5"
  }
}
