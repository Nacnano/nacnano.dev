{
  "name": "nacnano.dev",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@turbo/gen": "^2.5.5",
    "eslint": "^10.10.0",
    "eslint-config-custom": "workspace:*",
    "prettier": "^3.9.6",
    "turbo": "^2.5.5"
  },
  "trustedDependencies": [
    "esbuild",
    "contentlayer",
    "@contentlayer/core",
    "protobufjs",
    "core-js-pure"
  ]
}
