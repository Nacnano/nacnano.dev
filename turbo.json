{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {}
  },
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_GIT_COMMIT_SHA",
    "CI",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "VISIT_IP_SALT",
    "ERROR_REPORT_URL",
    "AMA_NOTIFY_URL",
    "DISCORD_BOT_TOKEN",
    "DISCORD_CHANNEL_ID",
    "DISCORD_DM_USER_ID"
  ]
}
